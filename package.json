{
  "name": "schema-preflight",
  "version": "1.0.0",
  "description": "Pre-flight schema validator — check your schema against BigQuery, Snowflake, Redshift, Spark, Hive, Postgres simultaneously before a single byte of data is produced",
  "main": "dist/index.js",
  "bin": { "preflight": "dist/cli.js" },
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["schema", "bigquery", "snowflake", "redshift", "spark", "hive", "data-engineering", "preflight"],
  "author": "Amrutham Akshithraj",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.2"
  }
}
